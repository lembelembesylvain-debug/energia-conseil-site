# Copiez vers .env.local (ignoré par Git via *.local) et remplissez :
# Messagerie CRM. RESEND_API_KEY reste sur le serveur (/api/messagerie-email).
# VITE_RESEND_API_KEY est lisible par le navigateur : ne l'utilisez que si vous acceptez de l'exposer.
RESEND_API_KEY=
VITE_RESEND_API_KEY=
VITE_SUPABASE_URL=https://VOTRE_PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Puis :
# 1) Exécuter supabase/migrations/20261005060000_crm_projets_leads_sync.sql dans le SQL Editor Supabase
# 2) Redémarrer Vite (npx vite --host 127.0.0.1 --port 5173)
# 3) CRM → Mode Production : bandeau « Production : Supabase Connecté (En Ligne) »
